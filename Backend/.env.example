# ============================================================================
# SCARA Backend — Environment Variables
# Copy this file to .env and fill in all values before starting the server.
# The server will refuse to start if any required variable is missing.
# NEVER commit .env to version control.
# ============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# The live website origin — used for CORS allow-list
FRONTEND_URL=https://scara.gg
# The admin panel origin — used for CORS allow-list
ADMIN_PANEL_URL=https://admin.scara.gg

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service_role key (NOT the anon key) — server-side only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET_NAME=scara-media
# Base URL for public objects — typically https://<bucket>.s3.<region>.amazonaws.com
# or your CloudFront distribution URL if CDN is configured
AWS_S3_PUBLIC_BASE_URL=https://scara-media.s3.ap-south-1.amazonaws.com

# ── Auth ─────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=7d
# Admin credentials — set via `npm run seed:admin` script, never store plaintext password
ADMIN_USERNAME=scara-admin
# bcrypt hash of the admin password — generated by scripts/seed-admin.ts
ADMIN_PASSWORD_HASH=$2a$12$your.bcrypt.hash.goes.here...

# ── Resend (email) ───────────────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# "From" address — must be a verified domain in Resend
EMAIL_FROM=SCARA <hello@scara.gg>
# Internal team inbox for new enquiry notifications
EMAIL_INTERNAL_TO=team@scara.gg
