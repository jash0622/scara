# ============================================================================
# SCARA Backend — PRODUCTION Environment Variables
# ============================================================================
# Copy this file to .env on the EC2 server and fill in all values.
# NEVER commit this file to git — it is listed in .gitignore.
# ============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://scara.gg
ADMIN_PANEL_URL=https://admin.scara.gg

# ── Supabase ─────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://lycdbadlplmfzkgwfibr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=FILL_THIS_FROM_SUPABASE_DASHBOARD

# ── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=FILL_THIS
AWS_SECRET_ACCESS_KEY=FILL_THIS
AWS_S3_BUCKET_NAME=scara-media
AWS_S3_PUBLIC_BASE_URL=https://scara-media.s3.ap-south-1.amazonaws.com

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=FILL_WITH_MINIMUM_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d
# Set after running: npm run seed:admin on the server
ADMIN_USERNAME=scara-admin
ADMIN_PASSWORD_HASH=FILL_AFTER_RUNNING_SEED_ADMIN

# ── Resend (email) ───────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=FILL_THIS
EMAIL_FROM=SCARA <hello@scara.gg>
EMAIL_INTERNAL_TO=team@scara.gg
