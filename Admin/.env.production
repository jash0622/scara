# ============================================================================
# SCARA Admin — PRODUCTION Environment Variables
# ============================================================================
# This file is safe to commit — it contains NO secrets.
# Next.js picks this up automatically when NODE_ENV=production.
# ============================================================================

# Admin calls backend via Next.js rewrites (/api/* → API_BASE_URL/api/*)
# NEXT_PUBLIC_API_BASE_URL is intentionally empty — rewrites handle routing
# so there are NO cross-origin requests from the browser at all.
NEXT_PUBLIC_API_BASE_URL=

# Server-side only — used by next.config.mjs rewrites to proxy to backend
# On EC2, backend runs on localhost:4000 (same machine, no CORS needed)
API_BASE_URL=http://localhost:4000
